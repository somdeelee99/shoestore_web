# Base URL of the NestJS API (ປ່ຽນເປັນ URL ຕົວຈິງຂອງ Render)
NUXT_PUBLIC_API_BASE="https://shoestore-backend-k6ue.onrender.com/api"

# Origin used to resolve relative image paths (/uploads/...)
NUXT_PUBLIC_API_ORIGIN="https://shoestore-backend-k6ue.onrender.com"

# Socket.IO server used by the Chat / Support page
NUXT_PUBLIC_SOCKET_URL="https://shoestore-backend-k6ue.onrender.com"