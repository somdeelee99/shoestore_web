# Base URL of the NestJS API (used by useApi / $fetch)
NUXT_PUBLIC_API_BASE="http://localhost:4000/api"

# Origin used to resolve relative image paths (/uploads/...)
NUXT_PUBLIC_API_ORIGIN="http://localhost:4000"

# Socket.IO server used by the Chat / Support page
NUXT_PUBLIC_SOCKET_URL="http://localhost:4000"
